PORT=3001

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Sandbox number while testing, or your approved WhatsApp sender in production
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Number that will receive the finished map (E.164 format)
WHATSAPP_TO_NUMBER=+573043383683

# Publicly reachable URL for this API (Twilio must be able to fetch the image from it).
# For local development, run a tunnel, e.g.: ngrok http 3001
PUBLIC_BASE_URL=https://your-tunnel-url.ngrok-free.app
